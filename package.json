{
  "name": "control-produccion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --env-file=.env.local server-lib/dev-server.js",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "create-admin": "node --env-file=.env.local scripts/create-initial-admin.mjs",
    "reset-password": "node --env-file=.env.local scripts/reset-user-password.mjs",
    "seed-personnel": "node --env-file=.env.local --import ./scripts/_esm-extensionless-loader.mjs scripts/seed-personnel.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "dayjs": "^1.11.12",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "prisma": "^7.9.1",
    "vite": "^5.4.0"
  }
}
