# Copiar a .env.local y llenar con valores reales. NUNCA commitear .env.local.

# Conexion pooled a Postgres (Neon) - usada por el runtime de la app
DATABASE_URL=

# Conexion directa/unpooled - usada solo por Drizzle Kit (generate/introspect/etc.)
DIRECT_URL=

# API key de Neon (console.neon.tech/app/settings/api-keys) -- SOLO necesaria para crear/gestionar
# branches de la base de datos (ej. una branch aislada de Preview). El runtime de la app nunca la
# usa, solo scripts puntuales de administracion.
NEON_API_KEY=

# Secreto para firmar las cookies de sesion (JWT). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# NUNCA commitear el valor real. En Vercel: agregar solo al entorno Preview por ahora.
JWT_SECRET=

# SSO real de Nextcloud (OIDC, Fase 5 de MI Stack Reference) -- convive en
# paralelo con el login local (JWT_SECRET arriba), nunca lo reemplaza. Sin
# estas 4 variables la ruta /api/auth/oidc/start responde 404 y el resto de
# la app sigue igual (ver server-lib/oidc.js). Solo un administrador del
# Nextcloud real puede emitir CLIENT_ID/CLIENT_SECRET (registrando esta app
# como cliente OIDC ahí).
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Debe coincidir EXACTO con el redirect URI registrado en Nextcloud, ej.
# https://centro-de-trabajo.mi2.com.mx/api/auth/oidc/callback
OIDC_REDIRECT_URI=

# Observabilidad (MI Stack Reference, sección 13) -- pendiente de que
# plataforma provisione un proyecto/DSN (ver checklist de credenciales).
# Sin estos valores, Sentry queda desactivado (no-op) tanto en backend
# como en frontend -- nunca rompe la app por falta de config.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
# Mismos valores, expuestos al bundle de Vite (prefijo VITE_ obligatorio
# para que Vite los incluya en el build del cliente).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=
