# Copiar a .env.local y llenar con valores reales. NUNCA commitear .env.local.

# Conexion pooled a Postgres (Neon) - usada por el runtime de la app
DATABASE_URL=

# Conexion directa/unpooled - usada solo por Prisma CLI (migrate, etc.)
DIRECT_URL=

# Secreto para firmar las cookies de sesion (JWT). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# NUNCA commitear el valor real. En Vercel: agregar solo al entorno Preview por ahora.
JWT_SECRET=

# Observabilidad (MI Stack Reference, sección 13) -- pendiente de que
# plataforma provisione un proyecto/DSN (ver checklist de credenciales).
# Sin estos valores, Sentry queda desactivado (no-op) tanto en backend
# como en frontend -- nunca rompe la app por falta de config.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
# Mismos valores, expuestos al bundle de Vite (prefijo VITE_ obligatorio
# para que Vite los incluya en el build del cliente).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=
